[project]
name = "{{project_name}}"
version = "0.1.0"
description = "Virtual env for running entangled and building docs."
authors = [{ name = "{{project_author_name}}", email = "{{project_author_email}}" }]
# You may still want to add a license here
# license = "Apache-2.0"
readme = "README.md"
requires-python = ">=3.13,<4"
dependencies = [
    "entangled-cli[jupyter]>=2.7.2",
    # List variables in the workflow in `entangled.toml`.
    "brei>=0.3.1",
    "ipykernel>=7.0",
    "zensical>=0.1.1",
]
